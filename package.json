  },
  "dependencies": {
    "@vueuse/core": "^14.1.0",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.0.1",
    "@iconify-json/carbon": "^1.2.18",
    "@types/node": "^20.19.30",
    "@unocss/eslint-plugin": "^66.6.0",
    "@unocss/transformer-directives": "^66.6.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "eslint": "^9.39.2",
    "eslint-plugin-format": "^1.3.1",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "simple-git-hooks": "^2.13.1",
    "taze": "^19.9.2",
    "typescript": "^5.9.3",
    "unocss": "^66.6.0",
    "unplugin-vue-router": "^0.19.2",
    "vite": "^7.3.1",
    "vitest": "^4.0.17",
    "vue-tsc": "^3.2.2"
  },
  "resolutions": {
    "unplugin": "^2.3.11",
    "vite": "^7.3.1"
  },
  "simple-git-hooks": {
